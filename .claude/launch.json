{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "C:/dev/flutter/bin/flutter.bat",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "5173",
        "--dart-define-from-file=env.json"
      ],
      "port": 5173
    },
    {
      "name": "web-release",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-m", "http.server", "5174", "--directory", "build/web"],
      "port": 5174
    }
  ]
}
